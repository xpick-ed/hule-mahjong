# Cloudflare Pages 的快取設定
# assets/ 的檔名有雜湊，內容永遠不變，可以快取一年；index.html 每次都要問新版
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

# 配音：檔名帶雜湊，內容不會變；index.json 每次都要問新版
/voice/*.mp3
  Cache-Control: public, max-age=31536000, immutable

/voice/index.json
  Cache-Control: no-cache

# Service Worker 每次都要問新版
/sw.js
  Cache-Control: no-cache

# 字型檔名帶雜湊
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
