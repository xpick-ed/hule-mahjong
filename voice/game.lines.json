 "meiling.line.hello.0": {
  "who": "meiling",
  "text": "來來來，今天手氣一定很好！"
 },
 "meiling.line.hello.1": {
  "who": "meiling",
  "text": "打完這圈我還要回去幫客人染頭髮喔"
 },
 "meiling.line.pon.0": {
  "who": "meiling",
  "text": "碰！這張我等很久了"
 },
 "meiling.line.pon.1": {
  "who": "meiling",
  "text": "碰～謝啦！"
 },
 "meiling.line.chi.0": {
  "who": "meiling",
  "text": "吃一下吃一下"
 },
 "meiling.line.chi.1": {
  "who": "meiling",
  "text": "這張我要了喔"
 },
 "meiling.line.kong.0": {
  "who": "meiling",
  "text": "槓！開花開花～"
 },
 "meiling.line.ting.0": {
  "who": "meiling",
  "text": "欸，我好像快了喔～"
 },
 "meiling.line.ting.1": {
  "who": "meiling",
  "text": "嘿嘿，你們小心點"
 },
 "meiling.line.tsumo.0": {
  "who": "meiling",
  "text": "自摸！大家掏錢掏錢～"
 },
 "meiling.line.tsumo.1": {
  "who": "meiling",
  "text": "哎唷，自己摸到了啦"
 },
 "meiling.line.ron.0": {
  "who": "meiling",
  "text": "胡啦！謝謝你喔～"
 },
 "meiling.line.ron.1": {
  "who": "meiling",
  "text": "就是這張！"
 },
 "meiling.line.dealIn.0": {
  "who": "meiling",
  "text": "唉唷，打錯了啦"
 },
 "meiling.line.dealIn.1": {
  "who": "meiling",
  "text": "早知道就不打這張"
 },
 "meiling.line.otherWin.0": {
  "who": "meiling",
  "text": "好啦好啦，給你胡"
 },
 "meiling.line.otherWin.1": {
  "who": "meiling",
  "text": "下一把換我"
 },
 "meiling.line.exhausted.0": {
  "who": "meiling",
  "text": "流局！再來再來"
 },
 "meiling.line.matchWin.0": {
  "who": "meiling",
  "text": "今天手氣真的不錯耶～"
 },
 "meiling.line.matchLose.0": {
  "who": "meiling",
  "text": "下次再找你們報仇！"
 },
 "meiling.line.reply.0": {
  "who": "meiling",
  "text": "欸～你很囂張喔"
 },
 "meiling.line.reply.1": {
  "who": "meiling",
  "text": "好啦好啦，舅媽讓你"
 },
 "meiling.line.friend.0": {
  "who": "meiling",
  "text": "欸你又來了！舅媽最喜歡跟你打"
 },
 "meiling.line.friend.1": {
  "who": "meiling",
  "text": "今天幫你留了最好的位子喔"
 },
